APP_NAME=Sentinel AI Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000
WORKERS=2

DATABASE_URL=sqlite:///./data/database/sentinel.db
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATA_DIR=./data
MODELS_DIR=./data/models
UPLOADS_DIR=./data/uploads
VIDEOS_DIR=./data/videos
FACES_DIR=./data/synthetic_faces

FACE_DETECTION_CONFIDENCE=0.7
FACE_RECOGNITION_THRESHOLD=0.6
BEHAVIOR_ANOMALY_THRESHOLD=0.75
DEEPFAKE_THRESHOLD=0.8
LIVENESS_THRESHOLD=0.7

MAX_CAMERA_FEEDS=4
FRAME_RATE=15
FRAME_WIDTH=640
FRAME_HEIGHT=480
VIDEO_BUFFER_SIZE=30

ENABLE_VOICE_ALERTS=True
ENABLE_EMAIL_ALERTS=False
ALERT_COOLDOWN_SECONDS=60

FEDERATED_ROUNDS=5
FEDERATED_MIN_NODES=2
FEDERATED_AGGREGATION_METHOD=fedavg

MAX_WORKERS=4
BATCH_SIZE=8
USE_GPU=False

LOG_LEVEL=INFO
LOG_FILE=./logs/sentinel.log
